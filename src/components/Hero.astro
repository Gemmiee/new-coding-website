---
// Swap these for the real links
const GITHUB_URL = 'https://github.com/Gemmiee';
const EMAIL = 'gemmie.dares407@passinbox.com';
---

<section class="hero">
	<div>
		<h1>
			<span class="typed">Hi, I'm </span><span class="typed name">Anastasia</span><span class="cursor"></span>
		</h1>
		<p class="description">
			<b>Computer Science</b> student and <b>Python</b> developer who likes turning ideas into clean,
			working code. I enjoy building small tools and learning new things.
		</p>

		<div class="links">
			<a class="btn btn-github" href={GITHUB_URL} target="_blank">
				<svg viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
				</svg>
				GitHub
			</a>
			<a class="btn btn-email" href={`mailto:${EMAIL}`}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="3" y="5" width="18" height="14" rx="2"></rect>
					<path d="m3 7 9 6 9-6"></path>
				</svg>
				Email
			</a>

			<!-- LinkedIn for later
			<span class="btn btn-empty">
				<svg viewBox="0 0 24 24" fill="currentColor">
					<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.83v1.5h.06c.53-1 1.84-2.05 3.79-2.05 4.05 0 4.8 2.67 4.8 6.13v5.42h-4v-4.8c0-1.15-.02-2.62-1.6-2.62-1.6 0-1.84 1.25-1.84 2.54v4.88h-4v-11Z"></path>
				</svg>
				LinkedIn
			</span>
			-->

		</div>
	</div>

	<img class="avatar" src="/corporate_gemmie.png" alt="Illustrated avatar of Anastasia" />
</section>

<style>
	.hero {
		max-width: 1400px;
		min-height: 100vh;
		margin: 0 auto;
		padding: 64px 40px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 80px;
	}

	h1 {
		margin: 0;
		font-size: clamp(3rem, 6vw, 5.5rem);
		line-height: 1;
		/* keeps the two lines' space reserved while typing */
		min-height: 2em;
	}

	.cursor {
		display: inline-block;
		width: 0.1em;
		height: 0.9em;
		margin-left: 0.08em;
		vertical-align: -0.1em;
		background: var(--orange);
		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.name {
		color: var(--name);
	}

	.description {
		margin: 32px 0 44px;
		font-size: 1.55rem;
		line-height: 1.6;
		color: var(--text);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 16px 32px;
		border: 2px solid var(--ink);
		border-radius: 12px;
		font-size: 1.35rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s;
	}

	.btn svg {
		width: 26px;
		height: 26px;
	}

	a.btn:hover {
		transform: translateY(-4px);
	}

	.btn-github {
		background: var(--ink);
		color: var(--bg);
	}

	.btn-email {
		background: var(--orange);
		color: var(--ink);
	}

	.btn-empty {
		border-style: dashed;
		color: var(--text);
	}

	.avatar {
		width: 100%;
		max-width: 620px;
		justify-self: center;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
			padding: 48px 16px;
		}

		.avatar {
			order: -1;
		}
	}
</style>

<script>
	// typing effect
	const parts = [...document.querySelectorAll<HTMLElement>('.typed')];
	const texts = parts.map((el) => el.textContent ?? '');

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		parts.forEach((el) => (el.textContent = ''));
		let part = 0;
		let letter = 0;

		function type() {
			if (part === parts.length) return;
			parts[part].textContent = texts[part].slice(0, ++letter);
			if (letter === texts[part].length) {
				part++;
				letter = 0;
			}
			setTimeout(type, 90);
		}

		setTimeout(type, 400);
	}
</script>
