---
const projects = [
	{
		title: 'Universifight',
		thumb: '/universifight.gif',
		thumbW: 800,
		thumbH: 550,
		note: '/stickynote.png',
		pin: '/pin1.png',
		desc: 'A 2D turn-based combat game built with Python and Pygame, started as a university project.',
		github: 'https://github.com/Gemmiee/Universifight',
		demo: 'https://github.com/Gemmiee/Universifight/releases',
		demoLabel: 'play',
	},
	{
		title: 'Online User Behavior Analyzer',
		thumb: '/UserAnalysis.png',
		thumbW: 994,
		thumbH: 604,
		note: '/stickynote.png',
		pin: '/pin2.png',
		desc: 'A group project analyzing online user behavior using Python and data visualization tools.',
		github: 'https://github.com/thanossavvopoulos/User_Online_Behavior_Analysis',
	},
	{
		title: 'Custom Image Classifier UI',
		thumb: '/ImgClass.png',
		thumbW: 1135,
		thumbH: 421,
		note: '/stickynote.png',
		pin: '/pin3.png',
		desc: 'A desktop app for training and deploying custom image classifiers, using a frozen ResNet-18 backbone for fast CPU training, with live progress and batch classification.',
		github: 'https://github.com/Gemmiee/custom_class_image_classification_UI',
	},
	{
		title: "Gemmie's Aero Art Site",
		thumb: '/ArtSite.png',
		thumbW: 1578,
		thumbH: 792,
		note: '/stickynote.png',
		pin: '/pin4.png',
		desc: 'My personal site built with Astro and styled as a retro desktop: music player, live chat, guestbook, blog, art gallery, dark mode, and embedded games.',
		demo: 'https://gemmiewow.com',
		demoLabel: 'visit',
	},
	{
		title: 'AI Image Generator with UI',
		thumb: '/AI_img.png',
		thumbW: 502,
		thumbH: 409,
		note: '/stickynote.png',
		pin: '/pin1.png',
		desc: 'AI image house generator: simple prompt box & a friendly Tkinter interface.',
		github: 'https://github.com/Gemmiee/AI-Image-Generator-with-UI',
	},
];
---

<section class="projects" id="projects">
	<h2>&gt; Projects</h2>

	<div class="board">
		{
			projects.map((p) => (
				<article class="card">
					<div class="note">
						<img class="note-bg" src={p.note} alt="" />
						<div class="note-content">
							<button class="thumb-btn" data-full={p.thumb} data-alt={p.title} style={`--ar: ${p.thumbW} / ${p.thumbH}`}>
								<img class="thumb" src={p.thumb} alt={p.title} loading="lazy" />
								<span class="zoom-hint">⤢ view</span>
							</button>
							<h3 class="note-title">{p.title}</h3>
							<p class="note-desc">{p.desc}</p>
							<div class="links">
								{p.github && (
									<a href={p.github} target="_blank" rel="noopener">
										↳ source
									</a>
								)}
								{p.demo && (
									<a href={p.demo} target="_blank" rel="noopener">
										↳ {p.demoLabel ?? 'demo'}
									</a>
								)}
							</div>
						</div>
						<img class="note-pin" src={p.pin} alt="" />
					</div>
				</article>
			))
		}
	</div>

	<div class="lightbox" id="project-lightbox" hidden>
		<div class="lightbox-backdrop" data-close />
		<button class="lightbox-close" data-close aria-label="Close">
			×
		</button>
		<img class="lightbox-img" id="project-lightbox-img" src="" alt="" />
	</div>
</section>

<style>
	.projects {
		max-width: 1400px;
		margin: 0 auto;
		padding: 32px 20px 64px;
	}

	h2 {
		margin: 0 0 32px;
		font-size: 3rem;
		line-height: 1;
	}

	.board {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 24px 16px;
	}

	.card:nth-child(1) {
		grid-column: 1 / 3;
		grid-row: 1;
	}

	.card:nth-child(2) {
		grid-column: 3 / 5;
		grid-row: 1;
	}

	.card:nth-child(3) {
		grid-column: 5 / 7;
		grid-row: 1;
	}

	.card:nth-child(4) {
		grid-column: 2 / 4;
		grid-row: 2;
	}

	.card:nth-child(5) {
		grid-column: 4 / 6;
		grid-row: 2;
	}

	.card {
		display: flex;
		flex-direction: column;
	}

	.note {
		position: relative;
		aspect-ratio: 1;
		overflow: hidden;
	}

	.note-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.note-pin {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	.note-content {
		position: relative;
		z-index: 1;
		container-type: inline-size;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8cqw;
		padding: 17% 10% 22%;
	}

	.thumb-btn {
		display: block;
		width: 76%;
		aspect-ratio: var(--ar);
		padding: 0;
		margin: 0;
		border: 3px solid var(--ink);
		background: #fff;
		cursor: zoom-in;
		overflow: hidden;
		position: relative;
	}

	.thumb {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.25s ease;
	}

	.thumb-btn:hover .thumb {
		transform: scale(1.05);
	}

	.zoom-hint {
		position: absolute;
		right: 6px;
		bottom: 6px;
		padding: 3px 8px;
		background: rgb(0 0 0 / 0.6);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 700;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.thumb-btn:hover .zoom-hint {
		opacity: 1;
	}

	.note-title {
		margin: 0;
		font-family: 'JetBrains Mono', monospace;
		font-weight: 600;
		font-size: clamp(1.25rem, 4.2cqw, 2.1rem);
		line-height: 1.1;
		color: var(--ink);
		text-align: center;
	}

	.note-desc {
		margin: 0;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-weight: 700;
		font-size: clamp(1.05rem, 3.1cqw, 1.65rem);
		line-height: 1.45;
		color: var(--text);
		text-align: center;
	}

	.links {
		display: flex;
		justify-content: center;
		gap: 10px;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.links a {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.links a:hover {
		color: var(--orange);
	}

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 40px;
	}

	.lightbox[hidden] {
		display: none;
	}

	.lightbox-backdrop {
		position: absolute;
		inset: 0;
		border: none;
		background: rgb(20 10 0 / 0.78);
	}

	.lightbox-img {
		position: relative;
		z-index: 1;
		display: block;
		max-width: 100%;
		max-height: 100%;
		border: 4px solid var(--bg);
	}

	.lightbox-close {
		position: absolute;
		top: 24px;
		right: 32px;
		z-index: 2;
		width: 40px;
		height: 40px;
		border: 2px solid var(--bg);
		border-radius: 999px;
		background: transparent;
		color: var(--bg);
		font-size: 1.4rem;
		line-height: 1;
		cursor: pointer;
	}

	@media (max-width: 900px) {
		.projects {
			padding: 32px 12px 48px;
		}

		.board {
			grid-template-columns: 1fr;
			max-width: 480px;
			margin: 0 auto;
			gap: 40px;
		}

		.card:nth-child(n) {
			grid-column: 1;
			grid-row: auto;
		}

		.note {
			aspect-ratio: auto;
		}

		.note-bg,
		.note-pin {
			object-fit: fill;
		}
	}
</style>

<script>
	const lightbox = document.getElementById('project-lightbox') as HTMLElement;
	const lightboxImg = document.getElementById('project-lightbox-img') as HTMLImageElement;

	const openLightbox = (src: string, alt: string) => {
		lightboxImg.src = src;
		lightboxImg.alt = alt;
		lightbox.hidden = false;
	};

	const closeLightbox = () => {
		lightbox.hidden = true;
		lightboxImg.src = '';
	};

	document.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			openLightbox(btn.dataset.full ?? '', btn.dataset.alt ?? '');
		});
	});

	lightbox.querySelectorAll('[data-close]').forEach((el) => {
		el.addEventListener('click', closeLightbox);
	});

	document.addEventListener('keydown', (e) => {
		if (!lightbox.hidden && e.key === 'Escape') closeLightbox();
	});
</script>
