---
const GITHUB_URL = 'https://github.com/Gemmiee';
const EMAIL = 'gemmie.dares407@passinbox.com';
---

<section class="contact" id="contact">
	<h2>&gt; Contact</h2>

	<div class="art">
		<div class="bubble-wrap">
			<img class="bubble" src="/speech_cloud.png" alt="" />
			<div class="bubble-content">
				<p class="label">find me:</p>
				<div class="links">
					<a class="btn btn-github" href={GITHUB_URL} target="_blank">
						<svg viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
							></path>
						</svg>
						GitHub
					</a>
					<a class="btn btn-email" href={`mailto:${EMAIL}`}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="3" y="5" width="18" height="14" rx="2"></rect>
							<path d="m3 7 9 6 9-6"></path>
						</svg>
						Email
					</a>
				</div>
			</div>
		</div>

		<img class="character" src="/gem_computer.png" alt="Illustrated avatar of Anastasia at her computer" />
	</div>
</section>

<style>
	.contact {
		padding: 32px 20px 48px;
	}

	h2 {
		margin: 0 0 12px;
		font-size: 3rem;
		line-height: 1;
	}

	.art {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.bubble-wrap {
		position: relative;
		z-index: 1;
		width: 74%;
		animation: float 3s ease-in-out infinite;
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}

	.bubble {
		display: block;
		width: 100%;
	}

	.bubble-content {
		position: absolute;
		inset: 11% 6% 28% 6%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}

	.label {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--ink);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 16px;
		border: 2px solid var(--ink);
		border-radius: 10px;
		font-size: 1.1rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s;
	}

	.btn svg {
		width: 20px;
		height: 20px;
	}

	.btn:hover {
		transform: translateY(-3px);
	}

	.btn-github {
		background: var(--ink);
		color: var(--bg);
	}

	.btn-email {
		background: var(--orange);
		color: var(--ink);
	}

	.character {
		display: block;
		width: 60%;
		margin-top: -24%;
		position: relative;
		z-index: 2;
	}

	@media (max-width: 900px) {
		.contact {
			padding: 32px 12px 48px;
		}
		h2 {
			margin-bottom: -10px;
		}
	}

	@media (min-width: 901px) {
		.art {
			position: relative;
			height: 300px;
			display: block;
		}

		.character {
			position: absolute;
			left: -7%;
			bottom: -10%;
			width: 50%;
			margin: 0;
		}

		.bubble-wrap {
			position: absolute;
			right: 12%;
			top: -20%;
			width: 55%;
		}
	}
</style>
