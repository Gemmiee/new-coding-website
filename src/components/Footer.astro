---
const GITHUB_URL = 'https://github.com/Gemmiee';
const ART_URL = 'https://gemmiewow.com';
const year = new Date().getFullYear();
---

<footer>
	<p>~/code.gemmiewow &middot; built with Astro &middot; {year}</p>
	<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
	<a href={ART_URL} target="_blank" rel="noopener">Art Website</a>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 16px;
		padding: 20px 16px;
		background: var(--ink);
		color: var(--bg);
		font-size: 0.9rem;
		text-align: center;
	}

	p {
		margin: 0;
	}

	a {
		color: var(--orange);
		text-decoration: none;
		font-weight: 700;
	}

	a:hover {
		text-decoration: underline;
	}
</style>
