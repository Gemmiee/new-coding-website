---
interface Props {
	title?: string;
}

const { title = 'Anastasia · Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml+png" href="/favicon.png" />
		<link rel="icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400..800&family=JetBrains+Mono:wght@400..800&family=Gloria+Hallelujah&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* palette3 RED */
	:root {
		--name: #e18b38;
		--orange: #ff9a21;
		--text: #873700;
		--ink: #4f1d00;
		--bg: #ffead6;
		--lines: rgb(135 55 0 / 0.12);
		--band: #febf8b;
	}

	/* palette1, GREEN 
	:root {
		--name: #458e1c;
		--orange: #ff9a21;
		--text: #056c26;
		--ink: #173d12;
		--bg: #f1e5cd;
		--lines: rgb(69 142 28 / 0.15);
		--band: #c9d58f;
	}
		*/

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 64px; /* so the sticky nav doesn't cover section titles */
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		background-color: var(--bg);
		/* graph paper */
		background-image:
			linear-gradient(var(--lines) 1px, transparent 1px),
			linear-gradient(90deg, var(--lines) 1px, transparent 1px);
		background-size: 28px 28px;
		color: var(--ink);
		font-family: 'JetBrains Mono', monospace;
	}

	p {
		font-family: 'Bricolage Grotesque', sans-serif;
	}
</style>
