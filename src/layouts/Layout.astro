---
interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Anastasia Coding Portfolio',
	description = "Computer science student and Python developer. View projects, skills and education.",
	image = '/link_img.png',
} = Astro.props;

const ogImage = new URL(image, Astro.site).toString();
const ogUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400..800&family=JetBrains+Mono:wght@400..800&family=Gloria+Hallelujah&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* palette3 RED */
	:root {
		--name: #e18b38;
		--orange: #e29332;
		--text: #873700;
		--ink: #4f1d00;
		--bg: #ffead6;
		--lines: rgb(135 55 0 / 0.12);
		--band: #febf8b;
	}

	/* palette1, GREEN 
	:root {
		--name: #458e1c;
		--orange: #ff9a21;
		--text: #056c26;
		--ink: #173d12;
		--bg: #f1e5cd;
		--lines: rgb(69 142 28 / 0.15);
		--band: #c9d58f;
	}
		*/

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 64px; /* so the sticky nav doesn't cover section titles */
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		background-color: var(--bg);
		/* graph paper */
		background-image:
			linear-gradient(var(--lines) 1px, transparent 1px),
			linear-gradient(90deg, var(--lines) 1px, transparent 1px);
		background-size: 28px 28px;
		color: var(--ink);
		font-family: 'JetBrains Mono', monospace;
	}

	p {
		font-family: 'Bricolage Grotesque', sans-serif;
	}
</style>
